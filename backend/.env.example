# ── VAPT Report Automation System — Environment Variables Template ─────────────
# Copy this file to backend/.env and fill in real values.
# ⚠️  NEVER commit backend/.env to source control.
# Add .env to your .gitignore file.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="VAPT Report Automation System"
APP_VERSION="2.0.0"

# Set to True ONLY during local development. Always False in production.
# When False: API docs (/docs, /redoc) are hidden, stack traces are suppressed.
DEBUG=False

# ── Auth — JWT Secret ─────────────────────────────────────────────────────────
# Generate a strong secret (minimum 32 bytes):
#   python -c "import secrets; print(secrets.token_hex(32))"
# This MUST be changed from the default before any production deployment.
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# JWT session expiry in minutes (default: 60 minutes)
JWT_EXPIRE_MINUTES=60

# ── AI — Gemini API Key ───────────────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
# Required for AI content generation features (/api/ai/generate).
# Leave empty to disable AI features.
GEMINI_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_EXPORT=30/minute
RATE_LIMIT_AI=20/minute

# ── File Uploads ──────────────────────────────────────────────────────────────
# Maximum upload size in megabytes
MAX_UPLOAD_MB=10

# ── CORS — Trusted Origins ────────────────────────────────────────────────────
# In production, set this to your actual frontend domain (no trailing slash).
# Example: CORS_ORIGINS=["https://vapt.yourdomain.com"]
# Default (local development):
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
